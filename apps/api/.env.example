APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ─── Database (SQLite via aiosqlite) ────────────────────────────────────
#
# Default is a local SQLite file managed by aiosqlite. The path is relative
# to the process's CWD; running the API from `apps/api/` puts the DB at
# `apps/api/tcsh.db`. Both URLs (runtime + Alembic migrations) point at
# the same file in dev — they're kept as separate knobs so a future
# deployment can target a different host for migrations.
#
# Production: override these to any SQLAlchemy async URL — e.g.
# `postgresql+asyncpg://...` if you swap back to Postgres later. URL-encode
# special characters in passwords (`$` → `%24`).
#
# Docker Compose: the named `api_db` volume mounts at `/data` inside the
# container. Point both URLs at `/data/tcsh.db` so the DB persists across
# `docker compose down`:
#   DATABASE_URL=sqlite+aiosqlite:////data/tcsh.db
#   DATABASE_URL_DIRECT=sqlite+aiosqlite:////data/tcsh.db
DATABASE_URL=sqlite+aiosqlite:///./tcsh.db
DATABASE_URL_DIRECT=sqlite+aiosqlite:///./tcsh.db

# ─── Local single-admin auth ────────────────────────────────────────────
# There is exactly one admin identity. JWTs are HS256-signed with JWT_SECRET.
# Generate ADMIN_PASSWORD_HASH via the CLI helper so you never paste a
# plaintext password into env files:
#
#   uv run python -m tcsh_ar_api.create_admin admin@example.com 'your-strong-password'
#
# That prints both ADMIN_PASSWORD_HASH and a fresh JWT_SECRET ready to paste.
# Rotate JWT_SECRET in production (and re-issue any outstanding tokens —
# changing the secret invalidates them all).
JWT_SECRET=replace-with-32-bytes-of-random-hex
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=
JWT_EXPIRES_SECONDS=86400

# ─── Local texture storage ──────────────────────────────────────────────
# Uploaded texture bytes land here. Created at startup if missing.
# The path is relative to the process's CWD (`apps/api/` for `make dev-api`).
TEXTURE_STORAGE_DIR=./storage/textures

# ─── Texture upload policy ──────────────────────────────────────────────
# Server-side mime allow-list and size cap. Adjust both sides if you want
# to admit a new format.
TEXTURE_ALLOWED_MIMES=["image/jpeg","image/png","image/webp","image/ktx2","model/gltf-binary"]
TEXTURE_MAX_SIZE_BYTES=10485760

# ─── CORS ───────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173"]
