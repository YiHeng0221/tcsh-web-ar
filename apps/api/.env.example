APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ─── Database (Supabase Postgres via Supavisor pooler) ──────────────────
#
# Two URLs because Alembic migrations and the FastAPI runtime want different
# pooler modes. After 2025-02-28, port 6543 only supports transaction mode.
#
#   DATABASE_URL         — runtime, Supavisor transaction pool (port 6543)
#   DATABASE_URL_DIRECT  — Alembic migrations, session mode (port 5432)
#
# Remember to swap the scheme from `postgresql://` to `postgresql+asyncpg://`
# so SQLAlchemy uses the async driver.
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── Supabase API keys (new 2025+ format) ───────────────────────────────
# Dashboard → Project Settings → API Keys → Create new API Keys.
# Publishable key replaces the legacy anon key (safe to ship to browsers).
# Secret key replaces the legacy service_role key (BACKEND ONLY, bypasses RLS).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── JWT verification (asymmetric JWKS, no static secret needed) ────────
# Dashboard → Project Settings → Auth → JWT Keys (or direct URL below).
# The static SUPABASE_JWT_SECRET is deprecated for new projects.
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

CORS_ORIGINS=["http://localhost:5173"]
