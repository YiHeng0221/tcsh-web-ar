APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ─── Database (Supabase Postgres via Supavisor pooler) ──────────────────
#
# Use Supavisor **session mode** (port 5432) for both runtime and migrations.
# Transaction mode (port 6543) is the right choice for serverless / edge
# functions that open-close a connection per request, but it does NOT support
# prepared statements — and SQLAlchemy's asyncpg dialect calls prepare() on
# every query. A long-running FastAPI server is not the intended workload
# for transaction mode.
#
# If you later run this on Cloudflare Workers or similar serverless
# runtime, switch DATABASE_URL to port 6543 and swap the DB driver for
# something that doesn't prepare statements.
#
# Remember to swap the scheme from `postgresql://` to `postgresql+asyncpg://`
# so SQLAlchemy uses the async driver. URL-encode special characters in the
# password (e.g. `$` → `%24`).
DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL_DIRECT=postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── Supabase API keys (new 2025+ format) ───────────────────────────────
# Dashboard → Project Settings → API Keys → Create new API Keys.
# Publishable key replaces the legacy anon key (safe to ship to browsers).
# Secret key replaces the legacy service_role key (BACKEND ONLY, bypasses RLS).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── JWT verification (asymmetric JWKS, no static secret needed) ────────
# Dashboard → Project Settings → Auth → JWT Keys (or direct URL below).
# The static SUPABASE_JWT_SECRET is deprecated for new projects.
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

CORS_ORIGINS=["http://localhost:5173"]
