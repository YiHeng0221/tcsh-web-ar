VITE_API_BASE_URL=http://localhost:8000

# Object-storage URL for the primary artwork glTF (Mode B viewer).
# Leave empty in dev — falls back to /models/TaiJai.glb, served from
# apps/web/public/models/ (gitignored; see that folder's README).
VITE_ARTWORK_MODEL_URL=

# Set to 1 to run the dev server over HTTPS (via vite-plugin-mkcert).
# Required for testing Mode A on a real iPhone — `getUserMedia` and
# `DeviceOrientationEvent.requestPermission` need a secure context.
# One-time setup: `brew install mkcert nss && mkcert -install`. See
# `docs/dev/https-local.md` for the iPhone trust steps.
VITE_HTTPS=
