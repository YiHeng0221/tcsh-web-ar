# ─── env ─────────────────────────────────
.env
.env.*
!.env.example

# ─── python ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── node / bun ──────────────────────────
node_modules/
dist/
.turbo/
bun.lockb
*.log

# ─── editors / os ────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ─── docker ──────────────────────────────
.docker-data/

# ─── project ─────────────────────────────
apps/web/dist
apps/api/.coverage

# ─── sqlite (local dev db, never committed) ──
*.db
*.db-shm
*.db-wal

# ─── binary assets (served by the API in dev, by object storage in prod) ─
# Dev keeps glTF / texture binaries under apps/web/public/models/ so
# Vite can serve them locally. In production they live in object storage;
# see apps/web/public/models/README.md.
apps/web/public/models/*.glb
apps/web/public/models/*.gltf
apps/web/public/models/*.bin
apps/web/public/models/*.ktx2

# ─── local texture storage (uploaded via Mode C admin) ──────────────────
# The API writes uploaded textures to apps/api/storage/. Never commit them.
apps/api/storage/
