# ─── env ─────────────────────────────────
.env
.env.*
!.env.example

# ─── python ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── node / bun ──────────────────────────
node_modules/
dist/
.turbo/
bun.lockb
*.log

# ─── editors / os ────────────────────────
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ─── docker ──────────────────────────────
.docker-data/

# ─── certs (mkcert / vite-plugin-mkcert) ─
*.pem
*.crt
*.key
.cert/
certs/

# ─── project ─────────────────────────────
apps/web/dist
apps/api/.coverage

# ─── binary assets (served from object storage in prod) ─────
# Dev keeps glTF / texture binaries under apps/web/public/models/ so
# Vite can serve them locally. In production they live in Supabase
# Storage per CLAUDE.md; see apps/web/public/models/README.md.
apps/web/public/models/*.glb
apps/web/public/models/*.gltf
apps/web/public/models/*.bin
apps/web/public/models/*.ktx2

# ─── claude code ─────────────────────────
# Per-agent worktree backups created by Claude Code workflows. Local-only
# scratch; never commit. `.claude/agents/`, `.claude/commands/`, and
# settings ARE committed — they're the team-shared harness.
.claude/worktrees/
